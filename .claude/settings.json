{
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(cp *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(mkdir *)",
      "Bash(mise *)",
      "Bash(pwd)",
      "Bash(touch *)",
      "Bash(sed *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(chown *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Read(**/.env*)",
      "Edit(**/.env*)"
    ],
    "ask": [
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(find * | xargs *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git filter-branch *)",
      "Bash(npx *)",
      "Bash(pnpm dlx *)",
      "Bash(bunx *)",
      "Bash(uvx *)",
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "default",
  "outputStyle": "Concise",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "switchModelsOnFlag": false,
  "skipAutoPermissionPrompt": true
}
