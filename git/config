[user]
  name  = mhiro2
  email = hirotsu.masaaki@gmail.com

[init]
  defaultBranch = main

[commit]
  template = ~/.config/git/commit_template
  verbose = true

[push]
  default = current
  autoSetupRemote = true

[pull]
  ff = only

[fetch]
  prune = true

[rebase]
  autostash = true
  updateRefs = true

[merge]
  conflictStyle = zdiff3

[rerere]
  enabled = true

[branch]
  sort = -committerdate

[tag]
  sort = -version:refname

[core]
  editor = nvim
  pager = delta

[color]
  ui = auto

[pager]
  branch = cat

[diff]
  colorMoved = default
  colorMovedWS = allow-indentation-change

[interactive]
  diffFilter = delta --color-only --features=interactive

[alias]
  a  = add
  b  = branch
  c  = checkout
  d  = diff
  f  = fetch
  l  = log
  lo = log --pretty=oneline
  p  = push
  r  = reset
  st = status
  ss = status -s
  sh = show

[delta]
  features = side-by-side line-numbers decorations
  navigate = true
  hyperlinks = true
  minus-style = normal "#660000"
  minus-emph-style = normal "#e00b00"
  plus-style = syntax "#084200"
  plus-emph-style = syntax "#14a100"
  syntax-theme = "Monokai Extended"
  whitespace-error-style = 22 reverse

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = cyan box ul

[ghq]
  root = ~/ghq
