#!/usr/bin/env bash
#MISE description="antidote をインストールする"
set -euo pipefail

TASK_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly TASK_DIR
REPO_ROOT="$(git -C "${TASK_DIR}" rev-parse --show-toplevel)"
readonly REPO_ROOT
cd "${REPO_ROOT}"

./scripts/install-antidote.sh install
