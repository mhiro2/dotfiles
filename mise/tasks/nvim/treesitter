#!/usr/bin/env bash
#MISE description="Tree-sitter parser をローカル生成する"
set -euo pipefail

TASK_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly TASK_DIR
REPO_ROOT="$(git -C "${TASK_DIR}" rev-parse --show-toplevel)"
readonly REPO_ROOT
cd "${REPO_ROOT}"

# shellcheck source=scripts/common.sh
source "${REPO_ROOT}/scripts/common.sh"

info "Tree-sitter parser をローカル生成します"
./nvim/scripts/build-treesitter-parsers.sh
success "Tree-sitter parser の生成が完了しました"
