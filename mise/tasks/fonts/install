#!/usr/bin/env bash
#MISE description="Moralerspace Neon フォントをインストールする"
set -euo pipefail

TASK_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly TASK_DIR
REPO_ROOT="$(git -C "${TASK_DIR}" rev-parse --show-toplevel)"
readonly REPO_ROOT
cd "${REPO_ROOT}"

# shellcheck source=scripts/common.sh
source "${REPO_ROOT}/scripts/common.sh"

if [[ "$(uname)" == "Darwin" ]]; then
  info "Moralerspace Neon フォントをインストールします"
  ./scripts/install-fonts.sh
  success "フォントのインストールが完了しました"
else
  skip "macOS 以外のためフォントインストールをスキップします"
fi
