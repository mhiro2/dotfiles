#!/usr/bin/env bash
#MISE description="dotfiles のシンボリックリンクを作成する"
set -euo pipefail

TASK_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly TASK_DIR
REPO_ROOT="$(git -C "${TASK_DIR}" rev-parse --show-toplevel)"
readonly REPO_ROOT
cd "${REPO_ROOT}"

./scripts/link-dotfiles.sh init
